{
	"name": "anniversary-reminder",
	"version": "0.0.0-dev",
	"description": "An Obsidian plugin for anniversary reminders.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit -skipLibCheck && node esbuild.config.mjs production",
		"release:prepare": "npm run build && node scripts/sync-version.mjs",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"vitest": "^2.1.9"
	}
}
